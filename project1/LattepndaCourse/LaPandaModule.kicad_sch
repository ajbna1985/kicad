	(text "Lite Carrier has no second BIOS ROM\n~{BIOS_SEL} pull up to 3.3V to select ROM on LattePanda Mu"
		(exclude_from_sim no)
		(at 366.522 262.636 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "9a2db227-0ffc-4f2f-b80a-5a488336fe67")
	)
	(text "SPI is only used to connect to the BIOS and discrete TPM.\nCannot be used as a general SPI interface."
		(exclude_from_sim no)
		(at 366.522 251.714 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "9a31fdff-a258-4eb0-8ae9-566488f935db")
	)
	(text "The default funtions ared defined as follows:\n\n-HSIO0: USB3.2 10Gbps\n-HSIO1: USB3.2 10Gbps\n-HSIO2: PCIe 3.0 x1\n-HSIO3: PCIe 3.0 x1\n\n-HSIO8: PCIe 3.0 x4 (lane 0)\n-HSIO9: PCIe 3.0 x4 (lane 1)\n-HSIO10: PCIe 3.0 x4 (lane 2)\n-HSIO11: PCIe 3.0 x4 (lane 3)\n\n-HSIO6: PCIe 3.0 x1"
		(exclude_from_sim no)
		(at 125.73 158.75 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left)
		)
		(uuid "9fd8b7ca-0af9-451f-a7aa-71c06e26e5b0")
	)
	(text "HPD pin of unused DDI/TCP port\nneeds to be pulled down"
		(exclude_from_sim no)
		(at 218.948 295.656 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a981cc46-997b-49b5-84fb-517b075fad88")
	)
	(text "~{CLKREQ} is reserved for PCIe ASPM L1s\nUnless the device clearly support it, pull it down to enhance compatiblity"
